# =============================================================================
# Root .env — INFRA / compose-level config only (used for ${VAR} substitution
# in the docker-compose files). The API's own application config lives in
# apps/api/.env (copy apps/api/.env.example). Copy this file to `.env`.
# =============================================================================

# ---- Which compose files to load --------------------------------------------
# Lets you run a plain `docker compose up --build` (no -f flags). Pick ONE:
#   local dev :  docker-compose.yml:docker-compose.dev.yml
#   VPS  prod :  docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- Host port bindings -----------------------------------------------------
API_HOST_PORT=8000
WEB_HOST_PORT=3000
# dev-only:
POSTGRES_HOST_PORT=5433
ADMINER_HOST_PORT=8080

# ---- Local Postgres (dev override only) -------------------------------------
# These create the throwaway dev DB and build the API's DATABASE_URL in
# docker-compose.dev.yml. Ignored in prod.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=visual_ai

# ---- Web build args (NEXT_PUBLIC_*, inlined into the client bundle) ---------
# LOCAL:  http://localhost:8000/api/v1
# PROD :  the public API URL your reverse proxy serves, e.g.
#         https://api.your-domain.com/api/v1
NEXT_PUBLIC_BASE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAX_UPLOAD_MB=50
NEXT_PUBLIC_USD_TO_INR=88

# =============================================================================
# PROD ONLY (docker-compose.prod.yml) — leave blank for local dev.
# =============================================================================

# Async SQLAlchemy URL for the shared external Postgres on the VPS. The host is
# the Postgres container's name/service on ${POSTGRES_NETWORK}.
# DATABASE_URL=postgresql+asyncpg://user:password@postgres-host:5432/visual_ai

# Name of the pre-existing docker network your shared Postgres is attached to.
# Find it on the VPS with `docker network ls`.
# POSTGRES_NETWORK=postgresql-k42d_default
