# Base URL of the FastAPI backend (include the /api/v1 prefix)
NEXT_PUBLIC_BASE_API_URL=http://localhost:8000/api/v1

# Client-side CSV upload cap in MB (UX guard; keep in sync with the API's MAX_UPLOAD_MB)
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Approximate USD→INR rate for displaying report cost in rupees (illustrative)
NEXT_PUBLIC_USD_TO_INR=88
