ENV=development
PROJECT_NAME="Visual AI Data Analyst"

# Database Configuration
# format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/visual_ai

# LLM Configuration
GOOGLE_API_KEY=your-google-gemini-api-key-here
# flash-lite is ~70% cheaper than flash and supports tool use + structured output.
# Use gemini-3.5-flash for the highest report-reasoning quality.
GEMINI_MODEL=gemini-3.5-flash-lite

# Security / Auth
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File storage root for uploaded CSVs + Parquet cache
STORAGE_DIR=storage

# Max CSV upload size in MB (small-data tier; protects the API from OOM)
MAX_UPLOAD_MB=50

# CORS — comma-separated origins allowed to call the API (the Next.js frontend)
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Email / verification ---------------------------------------------------
# Backend: console (logs the link) | smtp (Gmail / Mailpit) | resend (prod)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@visual-ai.local
EMAIL_FROM_NAME="Visual AI"

# --- SMTP: Gmail --------------------------------------------------------------
# EMAIL_FROM + SMTP_USER must be the SAME Gmail address. Requires 2-Step
# Verification ON + an App Password (myaccount.google.com/apppasswords).
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=your-account@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=true

# --- SMTP: Mailpit (local dev, no account) ------------------------------------
# docker run -p 1025:1025 -p 8025:8025 axllent/mailpit  (inbox at :8025)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USE_TLS=false

# --- Resend (production) ------------------------------------------------------
# Needs a verified sending domain. EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx

# Public frontend URL used to build the verification link in emails
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# --- Credits / Razorpay -----------------------------------------------------
# 1 credit ~= Rs 1 (see credit_packs). Serving cost ~Rs 0.65/report => ~90%+ margin.
# Free credits granted at email verification (~5 Standard reports).
SIGNUP_BONUS_CREDITS=50
# Report cost by class (current product == "standard").
REPORT_COST_QUICK=5
REPORT_COST_STANDARD=10
REPORT_COST_DEEP=20
# Razorpay: required only to sell credit packs. Without these, /credits/checkout
# returns 503 (free credits + report consumption still work). UPI is enabled in
# the Razorpay dashboard (Settings > Payment Methods), not in code.
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx              # set when creating the webhook in the dashboard
CREDIT_CURRENCY=inr
PAYMENT_SUCCESS_URL=http://localhost:3000/credits/success
PAYMENT_CANCEL_URL=http://localhost:3000/credits
# Comma-separated emails allowed to call admin credit endpoints.
ADMIN_EMAILS=
